{
  "name": "paastacode",
  "displayName": "PaastaCode | پاستاکد",
  "description": "رابط پاستاکد در VS Code با نشست مشترک وب و CLI",
  "version": "0.2.14",
  "icon": "icon.png",
  "publisher": "paasta",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Paasta-Cloud/PaastaCode.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./extension.cjs",
  "categories": [
    "AI"
  ],
  "activationEvents": [
    "onCommand:paastacode.open",
    "onCommand:paastacode.update",
    "onCommand:paastacode.billing",
    "onView:paastacode.home",
    "onCommand:paastacode.openEditor"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "paastacode.open",
        "title": "PaastaCode: باز کردن پاستاکد",
        "icon": "media/paasta-mark.svg"
      },
      {
        "command": "paastacode.update",
        "title": "PaastaCode: بررسی و نصب به‌روزرسانی",
        "icon": "$(sync)"
      },
      {
        "command": "paastacode.billing",
        "title": "PaastaCode: مدیریت اشتراک و مصرف",
        "icon": "$(credit-card)"
      },
      {
        "command": "paastacode.openEditor",
        "title": "PaastaCode: باز کردن در تب ویرایشگر",
        "icon": "$(open-preview)"
      }
    ],
    "configuration": {
      "title": "PaastaCode",
      "properties": {
        "paastacode.autoUpdate": {
          "type": "boolean",
          "default": true,
          "description": "بررسی و نصب خودکار به‌روزرسانی افزونه از انتشار رسمی پاستا",
          "scope": "machine"
        },
        "paastacode.clientPath": {
          "type": "string",
          "default": "",
          "description": "مسیر کامل bin/paastacode.mjs از نسخهٔ نصب‌شدهٔ پاستاکد",
          "scope": "machine"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "paastacode",
          "title": "PaastaCode",
          "icon": "media/paasta-mark.svg"
        }
      ]
    },
    "views": {
      "paastacode": [
        {
          "id": "paastacode.home",
          "name": "پاستاکد",
          "icon": "media/paasta-mark.svg",
          "contextualTitle": "PaastaCode",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "paastacode.open",
          "when": "workspaceFolderCount > 0",
          "group": "navigation@99"
        }
      ],
      "view/title": [
        {
          "command": "paastacode.openEditor",
          "when": "view == paastacode.home",
          "group": "navigation"
        },
        {
          "command": "paastacode.billing",
          "when": "view == paastacode.home",
          "group": "paastacode@1"
        },
        {
          "command": "paastacode.update",
          "when": "view == paastacode.home",
          "group": "paastacode@2"
        }
      ]
    }
  }
}
